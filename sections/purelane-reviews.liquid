{%- style -%}
  /* ----- Global CSS Variables & Cascade Fix ----- */
  :root {
    --sec-y: 34px;
  }
  @media(max-width: 760px) {
    :root {
      --sec-y: 22px;
    }
  }

  /* ----- Global Layout Utilities ----- */
  .wrap { max-width: 1180px; margin: 0 auto; padding: 0 18px; }
  .kicker { font-size: 11px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: rgba(36,26,61,.56); }

  /* ----- Section Specific Styles ----- */
  .purelane-revband {
    padding: var(--sec-y) 0;
    overflow: hidden;
    background: transparent; /* Lets the global .scenes background show through */
  }
  .purelane-revhead {
    display: flex; align-items: center; justify-content: center; gap: 10px 18px;
    flex-wrap: wrap; margin-bottom: 14px; padding: 0 18px;
  }
  .purelane-agg {
    display: inline-flex; align-items: center; gap: 8px; font-size: 11.5px;
    font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: rgba(36,26,61,.78);
  }
  .purelane-agg b { font-family: 'Outfit', sans-serif; font-size: 16px; color: #b8701c; letter-spacing: 0; }
  
  .purelane-agg .purelane-st { color: #7a9c1e; font-size: 12px; letter-spacing: .16em; }
  .purelane-rcard .purelane-st { color: #7a9c1e; font-size: 10.5px; letter-spacing: .2em; margin-bottom: 9px; }

  .purelane-revrail {
    overflow: hidden; position: relative;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }
  .purelane-revtrack {
    display: flex; gap: 12px; width: max-content; animation: purelane-marq 52s linear infinite;
  }
  .purelane-revrail:hover .purelane-revtrack,
  .purelane-revrail:focus-within .purelane-revtrack {
    animation-play-state: paused;
  }
  
  @keyframes purelane-marq {
    from { transform: translate3d(0,0,0); }
    to { transform: translate3d(-50%,0,0); }
  }

  .purelane-rcard {
    flex: 0 0 auto; width: 284px; padding: 15px 17px; border-radius: 18px;
    /* Background, blur, and border inherited securely from .glass-2 in base.css */
  }
  .purelane-rcard h5 {
    font-family: 'Outfit', sans-serif; font-size: 12px; font-weight: 700;
    text-transform: uppercase; letter-spacing: .05em; color: #17102b; margin: 0 0 7px;
  }
  .purelane-rcard p { font-size: 12.6px; color: rgba(36,26,61,.78); line-height: 1.52; margin-bottom: 11px; }
  .purelane-who {
    display: flex; align-items: center; gap: 7px; font-size: 9.5px; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase; color: rgba(36,26,61,.56);
  }
  .purelane-who b { color: #01423b; font-weight: 700; }
  .purelane-who svg { width: 12px; height: 12px; color: #4f7d10; flex: 0 0 auto; }

  @media(max-width: 760px) {
    .purelane-rcard { width: 250px; padding: 13px 14px; }
    .purelane-revtrack { animation-duration: 40s; }
  }
  @media(prefers-reduced-motion: reduce) {
    .purelane-revtrack { animation: none; }
  }
{%- endstyle -%}

<section class="purelane-revband" data-scene="1">
  <div class="wrap">
    <div class="purelane-revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="purelane-agg">
        <span class="purelane-st">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
        <b>{{ section.settings.rating }}</b> {{ section.settings.rating_text }}
      </span>
      <span class="purelane-agg">
        {{ section.settings.loved_by_text }} <b>{{ section.settings.loved_by_number }}</b>
      </span>
    </div>
  </div>

  <div class="purelane-revrail rv" aria-label="Customer reviews">
    <div class="purelane-revtrack">
      {%- for i in (1..2) -%}
        {%- for block in section.blocks -%}
          <article class="purelane-rcard glass-2" {{ block.shopify_attributes }}>
            <div class="purelane-st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
            <h5>{{ block.settings.title }}</h5>
            <p>{{ block.settings.review_text }}</p>
            <div class="purelane-who">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
              <b>{{ block.settings.author }}</b>
              <span>&middot; {{ block.settings.product_reference }}</span>
            </div>
          </article>
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating", "label": "Average Rating", "default": "4.8" },
    { "type": "text", "id": "rating_text", "label": "Rating Context", "default": "from 8,000+ reviews" },
    { "type": "text", "id": "loved_by_text", "label": "Loved By Text", "default": "Loved by" },
    { "type": "text", "id": "loved_by_number", "label": "Loved By Number", "default": "12 lakh+ homes" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review Card",
      "settings": [
        { "type": "text", "id": "title", "label": "Headline", "default": "Works like a charm" },
        { "type": "textarea", "id": "review_text", "label": "Review Body", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "author", "label": "Reviewer Name", "default": "Anita" },
        { "type": "text", "id": "product_reference", "label": "Product Tag", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews Marquee"
    }
  ]
}
{% endschema %}