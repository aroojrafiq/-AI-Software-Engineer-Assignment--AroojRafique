{%- style -%}
  /* ----- Section-Scoped Layout Styles ----- */
  .purelane-combos-wrap { padding: clamp(26px, 3.4vw, 40px) 0; background: transparent; }
  .comborail-header { text-align: center; max-width: 1180px; margin: 0 auto; padding: 0 18px; }
  .purelane-kicker { font-size: 11px; font-weight: 700; letter-spacing: .22em; text-transform: uppercase; color: rgba(36,26,61,.56); }
  .purelane-d2 { font-family: 'Outfit', sans-serif; font-size: clamp(30px, 4.6vw, 54px); font-weight: 800; line-height: .94; text-transform: uppercase; color: #17102b; margin: 12px 0; }
  .purelane-lede { font-size: 15px; color: rgba(36,26,61,.78); max-width: 44ch; margin: 0 auto; }
  
  .purelane-rule { display: flex; align-items: center; justify-content: center; gap: 13px; margin: 0 auto 16px; max-width: 240px; }
  .purelane-rule i { height: 1px; flex: 1; }
  .purelane-rule i:first-child { background: linear-gradient(90deg, transparent, rgba(75,58,143,.34)); }
  .purelane-rule i:last-child { background: linear-gradient(90deg, rgba(75,58,143,.34), transparent); }
  .purelane-rule svg { width: 16px; height: 16px; color: #b8701c; flex: 0 0 auto; }

  /* ----- Rail & Card Mechanics ----- */
  .comborail {
    display: flex; gap: 14px; overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory;
    margin: 0 -18px; padding: 4px 18px 14px; scrollbar-width: none; -webkit-overflow-scrolling: touch;
  }
  .comborail::-webkit-scrollbar { display: none; }

  .combo-card {
    flex: 0 0 302px; scroll-snap-align: start; display: flex; flex-direction: column; 
    transition: transform .4s ease; border-radius: 26px;
  }
  .combo-card:hover { transform: translateY(-5px); }
  .combo-card.hero-combo {
    border-color: rgba(201,118,29,.46);
    box-shadow: 0 22px 54px rgba(58,44,112,.14), 0 0 0 1px rgba(201,118,29,.24), inset 0 1px 0 rgba(255,255,255,.92);
  }

  /* ----- Card Internals ----- */
  .combo-tray {
    padding: 14px 14px 13px; border-bottom: 1px solid rgba(75,58,143,.12); position: relative;
    background: linear-gradient(162deg, rgba(255,255,255,.56), rgba(236,230,247,.34));
  }
  .combo-save-badge {
    display: inline-block; font-size: 9.5px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase;
    padding: 5px 11px; border-radius: 999px; background: rgba(255,255,255,.84); border: 1px solid rgba(201,118,29,.34);
    color: #4f7d10; margin-bottom: 13px;
  }
  .combo-flag {
    position: absolute; top: 14px; right: 14px; font-size: 8.6px; font-weight: 800; letter-spacing: .1em;
    text-transform: uppercase; padding: 5px 10px; border-radius: 999px; background: linear-gradient(135deg,#00706a,#004b46); color: #f4fdf6;
  }
  .combo-stack { display: flex; align-items: flex-end; gap: 3px; }
  .combo-item { flex: 1 1 0; min-width: 0; text-align: center; }
  .combo-item img { height: 66px; margin: 0 auto 8px; object-fit: contain; filter: drop-shadow(0 5px 8px rgba(0,74,66,.13)); }
  .combo-item span { display: block; font-size: 8.6px; line-height: 1.32; color: rgba(36,26,61,.78); font-weight: 600; }
  .combo-plus { flex: 0 0 9px; color: #b8701c; font-weight: 800; font-size: 12px; padding-bottom: 30px; text-align: center; }
  
  .combo-body { padding: 15px 16px 18px; display: flex; flex-direction: column; flex: 1; }
  .combo-body h3 { font-family: 'Outfit', sans-serif; font-size: 16px; font-weight: 700; text-transform: uppercase; color: #17102b; margin: 0; }
  .combo-cnt { font-size: 10.5px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: rgba(36,26,61,.56); margin-top: 6px; }
  .combo-inc { font-size: 12.4px; color: rgba(36,26,61,.78); margin: 11px 0 14px; flex: 1; }
  
  .combo-prow { display: flex; align-items: baseline; gap: 9px; flex-wrap: wrap; margin-bottom: 6px; }
  .combo-prow strong { font-family: 'Outfit', sans-serif; font-size: 25px; font-weight: 800; color: #17102b; }
  .combo-prow s { font-size: 13px; color: rgba(36,26,61,.56); }
  .combo-prow em {
    font-style: normal; font-size: 9.5px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase;
    padding: 4px 9px; border-radius: 999px; background: rgba(201,118,29,.14); border: 1px solid rgba(201,118,29,.34); color: #4f7d10;
  }
  .combo-fine { font-size: 10.4px; color: rgba(36,26,61,.56); margin-bottom: 14px; }
  
  .combo-btn {
    width: 100%; justify-content: center; display: inline-flex; align-items: center; height: 46px; border-radius: 999px;
    font-size: 12.5px; font-weight: 700; letter-spacing: .13em; text-transform: uppercase; text-decoration: none; transition: 0.3s; cursor: pointer; border: none;
  }
  .combo-btn:focus-visible { outline: 2px solid #b8701c; outline-offset: 3px; border-radius: 999px; }
  .combo-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  .combo-btn-ghost { background: rgba(255,255,255,.66); border: 1px solid rgba(75,58,143,.22); color: #01423b; }
  .combo-btn-ghost:hover:not(:disabled) { background: rgba(255,255,255,.9); transform: translateY(-2px); }
  .combo-btn-primary { background: linear-gradient(135deg, #00706a, #004b46); color: #f4fdf6; box-shadow: 0 12px 26px rgba(0,80,74,.26); }
  .combo-btn-primary:hover:not(:disabled) { box-shadow: 0 18px 36px rgba(0,80,74,.32); transform: translateY(-2px); }
  
  .swipecue {
    display: flex; align-items: center; justify-content: center; gap: 8px; font-size: 10px; font-weight: 700;
    letter-spacing: .16em; text-transform: uppercase; color: rgba(36,26,61,.56); margin-top: 10px;
  }

  @media(max-width: 760px) {
    .combo-card { flex: 0 0 268px; }
    .comborail { margin: 0 -14px; padding: 4px 14px 12px; }
    .combo-tray .combo-item img { height: 56px; }
  }
{%- endstyle -%}

<section class="purelane-combos-wrap" data-scene="3">
  <div class="comborail-header rv">
    <span class="purelane-kicker">{{ section.settings.kicker }}</span>
    <h2 class="purelane-d2">{{ section.settings.heading }}</h2>
    <div class="purelane-rule">
      <i></i>
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
      <i></i>
    </div>
    <p class="purelane-lede" style="margin:14px auto 0;">{{ section.settings.description }}</p>
  </div>

  <div class="comborail rv">
    {%- for block in section.blocks -%}
      <article class="glass combo-card {% if block.settings.is_featured %}hero-combo{% endif %} rv rv-d{{ forloop.index | default: 1 }}" {{ block.shopify_attributes }}>
        <div class="combo-tray">
          
          {%- assign bundle = block.settings.bundle_product -%}
          {%- if bundle != blank and bundle.compare_at_price > bundle.price -%}
             {%- assign exact_saving = bundle.compare_at_price | minus: bundle.price -%}
             <span class="combo-save-badge">You save {{ exact_saving | money_without_trailing_zeros }}</span>
          {%- endif -%}

          {%- if block.settings.flag_badge != blank -%}
            <span class="combo-flag">{{ block.settings.flag_badge }}</span>
          {%- endif -%}
          
          <div class="combo-stack">
            {%- assign p1 = block.settings.product_1 -%}
            {%- assign p2 = block.settings.product_2 -%}
            {%- assign p3 = block.settings.product_3 -%}

            {%- if p1 != blank -%}
              <span class="combo-item">
                <img src="{{ p1.featured_image | image_url: width: 150 }}" alt="{{ p1.title | escape }}" loading="lazy">
                <span>{{ block.settings.label_1 | default: p1.title }}</span>
              </span>
            {%- endif -%}

            {%- if p2 != blank -%}
              <span class="combo-plus" aria-hidden="true">+</span>
              <span class="combo-item">
                <img src="{{ p2.featured_image | image_url: width: 150 }}" alt="{{ p2.title | escape }}" loading="lazy">
                <span>{{ block.settings.label_2 | default: p2.title }}</span>
              </span>
            {%- endif -%}

            {%- if p3 != blank -%}
              <span class="combo-plus" aria-hidden="true">+</span>
              <span class="combo-item">
                <img src="{{ p3.featured_image | image_url: width: 150 }}" alt="{{ p3.title | escape }}" loading="lazy">
                <span>{{ block.settings.label_3 | default: p3.title }}</span>
              </span>
            {%- endif -%}
          </div>
        </div>

        <div class="combo-body">
          <h3>{{ block.settings.title }}</h3>
          <div class="combo-cnt">{{ block.settings.item_count_text }}</div>
          <p class="combo-inc">{{ block.settings.description }}</p>
          
          <div class="combo-prow">
            {%- if bundle != blank -%}
              <strong>{{ bundle.price | money }}</strong>
              {%- if bundle.compare_at_price > bundle.price -%}
                <s>{{ bundle.compare_at_price | money }}</s>
                <em>Save {{ exact_saving | money_without_trailing_zeros }}</em>
              {%- endif -%}
            {%- else -%}
              <strong>{{ 0 | money }}</strong>
              <em>Select a bundle product</em>
            {%- endif -%}
          </div>
          
          <div class="combo-fine">{{ section.settings.fine_text }}</div>
          
          {%- if bundle != blank -%}
            <!-- Dawn AJAX Wrapper -->
            <product-form class="product-form" style="width: 100%;">
              {%- assign combo_form_id = 'combo-form-' | append: bundle.id | append: '-' | append: forloop.index -%}
              {%- form 'product', bundle, id: combo_form_id, class: 'form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input type="hidden" name="id" value="{{ bundle.selected_or_first_available_variant.id }}">
                <button type="submit" class="combo-btn {% if block.settings.is_featured %}combo-btn-primary{% else %}combo-btn-ghost{% endif %}" {% if bundle.available == false %}disabled{% endif %}>
                  {{ block.settings.btn_text }} 
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" style="width:15px; height:15px; margin-left:8px;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
                </button>
              {%- endform -%}
            </product-form>
          {%- else -%}
            <button type="button" disabled class="combo-btn combo-btn-ghost">Select Bundle in Editor</button>
          {%- endif -%}

        </div>
      </article>
    {%- endfor -%}
  </div>

  <div class="swipecue" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" style="width:14px; height:14px; color:#b8701c;"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
    Swipe for more combos
  </div>
</section>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "Pre-built to save you money" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Best selling combos" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own." },
    { "type": "text", "id": "fine_text", "label": "Fine Print Text", "default": "Inclusive of all taxes · COD available" }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Bundle",
      "settings": [
        { "type": "checkbox", "id": "is_featured", "label": "Highlight as Featured (Orange Border)", "default": false },
        { "type": "text", "id": "title", "label": "Combo Name", "default": "Kitchen essentials" },
        { "type": "text", "id": "item_count_text", "label": "Item Count Text", "default": "3 products" },
        { "type": "textarea", "id": "description", "label": "Description", "default": "Includes: Foaming Kitchen Cleaner, Dishwash Gel & Tap Cleaner." },
        { "type": "text", "id": "flag_badge", "label": "Top Right Flag (Optional)", "default": "Most popular" },
        { "type": "product", "id": "bundle_product", "label": "Bundle Product (for pricing & cart)" },
        { "type": "text", "id": "btn_text", "label": "Button Text", "default": "Shop bundle" },
        { "type": "header", "content": "Stack Items (Max 3)" },
        { "type": "product", "id": "product_1", "label": "Product 1" },
        { "type": "text", "id": "label_1", "label": "Short label for Product 1", "default": "Cuts grease instantly" },
        { "type": "product", "id": "product_2", "label": "Product 2" },
        { "type": "text", "id": "label_2", "label": "Short label for Product 2", "default": "Squeaky clean dishes" },
        { "type": "product", "id": "product_3", "label": "Product 3 (Optional)" },
        { "type": "text", "id": "label_3", "label": "Short label for Product 3", "default": "Melts hard water stains" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos"
    }
  ]
}
{% endschema %}